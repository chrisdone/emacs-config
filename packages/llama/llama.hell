data Command
  = GetEmbeddings
  | OK

parseGetEmbeddings = Applicative.pure Main.GetEmbeddings

cmdParser =
  Options.hsubparser
    ( Options.command "get-embeddings"    (Options.info Main.parseGetEmbeddings (Options.progDesc "Get embeddings"))
    )

main = do
  let opts = Options.info (Main.cmdParser <**> Options.helper) Options.fullDesc
  cmd <- Options.execParser opts
  case cmd of
    GetEmbeddings -> Main.getEmbeddingsCmd
    OK -> Text.putStrLn "OK"

--------------------------------------------------------------------------------
-- Commands

getEmbeddingsCmd = do
  text <- Text.getContents
  vector <- Main.getEmbeddings text
  ByteString.hPutStr IO.stdout $ Json.encode $ Json.Array vector

--------------------------------------------------------------------------------
-- Utilities

getEmbeddings = \input -> do
  let payload = Json.Object $ Map.fromList [("input", Json.String input)]
  output <- ByteString.readProcessStdout_ $
    Text.setStdin (Text.decodeUtf8 $ Json.encode payload) $
    Process.proc "curl"
        ["-s", "http://localhost:9990/v1/embeddings",
        "-H", "Content-Type: application/json",
        "-X", "POST",
        "--data-binary", "@-"]
  json <- Main.jq (Text.decodeUtf8 output) [".data[0].embedding", "-j"]
  vector <- 
    case json of
      Json.Array vector -> IO.pure vector
      _ -> Error.error "Embeddings should be an array."
  IO.pure vector

jq :: Text -> [Text] -> IO Value = \json args -> do
  out <- ByteString.readProcessStdout_ $ Text.setStdin json $ Process.proc "jq" args
  case Json.decode out of
    Maybe.Just value -> IO.pure value
    _ -> Error.error "Bad JSON parse."
