--------------------------------------------------------------------------------
-- Types

data Command
  = GetEmbeddings
  | StoreFragment Main.Fragment
  | SearchFragments Main.Search

-- <https://qdrant.tech/documentation/manage-data/points/>
data Point = Point {
 id :: Text,
 vector :: Vector Value,
 payload :: Text
 }

data Search = Search {
 collection :: Text,
 query :: Text,
 limit :: Int
 }

data Fragment = Fragment {
 collection :: Text,
 sample :: Text,
 metadata :: Text
 }

--------------------------------------------------------------------------------
-- Main entry point

parseGetEmbeddings = Applicative.pure Main.GetEmbeddings

parseCollection = Options.strOption (Option.long "collection" <> Option.help "Qdrant collection name")

parseStoreFragment =
  Main.StoreFragment <$>
    (
      (\collection metadata sample -> Main.Fragment { collection, metadata, sample })
      <$> Main.parseCollection
      <*> Options.strOption (Option.long "metadata" <> Option.help "Metadata")
      <*> Options.strOption (Option.long "sample" <> Option.help "Sample content")
    )

parseSearchFragments =
  Main.SearchFragments <$>
    (
      (\collection query limit -> Main.Search { collection, query, limit })
      <$> Main.parseCollection
      <*> Options.strOption (Option.long "query" <> Option.help "Search query")
      <*> Functor.fmap
            (\(s :: Text) -> Maybe.maybe (Error.error "--limit: expected an integer") Function.id (Int.readMaybe s))
            (Options.strOption (Option.long "limit" <> Option.help "Max number of results"))
    )

cmdParser =
  Options.hsubparser
    ( Options.command "get-embeddings" (Options.info Main.parseGetEmbeddings (Options.progDesc "Get embeddings")) <>
    Options.command "store-fragment" (Options.info Main.parseStoreFragment (Options.progDesc "Store fragment")) <>
    Options.command "search-fragments" (Options.info Main.parseSearchFragments (Options.progDesc "Search fragments"))
    )

main = do
  let opts = Options.info (Main.cmdParser <**> Options.helper) Options.fullDesc
  cmd <- Options.execParser opts
  case cmd of
    GetEmbeddings -> Main.getEmbeddingsCmd
    StoreFragment fragment -> Main.storeFragment fragment
    SearchFragments search -> Main.searchFragmentsCmd search

--------------------------------------------------------------------------------
-- Commands

searchFragmentsCmd = \search -> do
  results <- Main.searchFragments (Record.get @"collection" search) (Record.get @"query" search) (Record.get @"limit" search)
  ByteString.hPutStr IO.stdout $ Json.encode $ Json.Array results

getEmbeddingsCmd :: IO () = do
  text <- Text.getContents
  vector <- Main.getEmbeddings text
  ByteString.hPutStr IO.stdout $ Json.encode $ Json.Array vector

--------------------------------------------------------------------------------
-- Model

storeFragment :: Main.Fragment -> IO () = \fragment -> do
  id <- Main.uuidv4
  vector <- Main.getEmbeddings $ Record.get @"sample" fragment
  Main.putPoints (Record.get @"collection" fragment) Main.Point {
      id,
      payload = Record.get @"metadata" fragment,
      vector
    }

searchFragments :: Text -> Text -> Int -> IO (Vector Value) = \collection query limit -> do
  vector <- Main.getEmbedding query
  Main.searchPoints collection vector (Double.fromInt limit)

--------------------------------------------------------------------------------
-- API clients

getEmbeddings = \input -> do
  let payload = Json.Object $ Map.fromList [("input", Json.String input)]
  output <- ByteString.readProcessStdout_ $
    Text.setStdin (Text.decodeUtf8 $ Json.encode payload) $
    Process.proc "curl"
        ["-s", Main.embeddingsPrefix <> "/v1/embeddings",
        "-H", "Content-Type: application/json",
        "-X", "POST",
        "-f",
        "--data-binary", "@-"]
  json <- Main.jq (Text.decodeUtf8 output) [".data[0].embedding", "-j"]
  vector <- 
    case json of
      Json.Array vector -> IO.pure vector
      _ -> Error.error "Embeddings should be an array."
  IO.pure vector

-- Uses llama-server's non-OpenAI /embedding endpoint, which returns
-- [{"index":0,"embedding":[[...]]}].
getEmbedding :: Text -> IO (Vector Value) = \content -> do
  let payload = Json.Object $ Map.fromList [("content", Json.String content)]
  output <- ByteString.readProcessStdout_ $
    Text.setStdin (Text.decodeUtf8 $ Json.encode payload) $
    Process.proc "curl"
        ["-s", Main.embeddingsPrefix <> "/embedding",
        "-H", "Content-Type: application/json",
        "-X", "POST",
        "-f",
        "--data-binary", "@-"]
  json <- Main.jq (Text.decodeUtf8 output) [".[0].embedding[0]", "-j"]
  case json of
    Json.Array vector -> IO.pure vector
    _ -> Error.error "Embedding should be an array."

putPoints = \(collection :: Text) (point :: Main.Point) -> do
  let payload = Json.Object $ Map.fromList [("points", Json.Array $ Vector.fromList [
          Json.Object $ Map.fromList [
            ("id", Json.String $ Record.get @"id" point),
            ("vector", Json.Array $ Record.get @"vector" point),
            ("payload", Maybe.maybe (Error.error "putPoints: Bad JSON payload!") Function.id
                          $ Json.decode $ Text.encodeUtf8 $ Record.get @"payload" point)
           ]
        ])]
  -- ByteString.hPutStr IO.stdout $ Json.encode payload
  Process.runProcess_ $
    Text.setStdin (Text.decodeUtf8 $ Json.encode payload) $
    Process.proc "curl"
        ["-s", Main.qdrantPrefix <> "/collections/" <> collection <> "/points?wait=true",
        "-H", "Content-Type: application/json",
        "-X", "PUT",
        "--data-binary", "@-"]

searchPoints :: Text -> Vector Value -> Double -> IO (Vector Value) = \collection vector limit -> do
  let payload = Json.Object $ Map.fromList [
        ("vector", Json.Array vector),
        ("limit", Json.Number limit),
        ("with_payload", Json.Bool Bool.True)
       ]
  output <- ByteString.readProcessStdout_ $
    Text.setStdin (Text.decodeUtf8 $ Json.encode payload) $
    Process.proc "curl"
        ["-s", Main.qdrantPrefix <> "/collections/" <> collection <> "/points/search",
        "-H", "Content-Type: application/json",
        "-X", "POST",
        "-f",
        "--data-binary", "@-"]
  json <- Main.jq (Text.decodeUtf8 output) [".result", "-j"]
  case json of
    Json.Array results -> IO.pure results
    _ -> Error.error "Search results should be an array."

--------------------------------------------------------------------------------
-- Utilities

jq :: Text -> [Text] -> IO Value = \json args -> do
  out <- ByteString.readProcessStdout_ $ Text.setStdin json $ Process.proc "jq" args
  case Json.decode out of
    Maybe.Just value -> IO.pure value
    _ -> Error.error "Bad JSON parse."

sha256 = \content ->
  Functor.fmap (Text.take 64) $ Text.readProcessStdout_ $ Text.setStdin content $
    Process.proc "sha256sum" ["-"]

uuidv4 = Functor.fmap Text.strip $ Text.readFile "/proc/sys/kernel/random/uuid"

qdrantPrefix = "http://localhost:6333"

embeddingsPrefix = "http://localhost:9990"
