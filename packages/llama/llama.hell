data Command
  = GetEmbeddings
  | OK

parseGetEmbeddings = Applicative.pure Main.GetEmbeddings

cmdParser =
  Options.hsubparser
    ( Options.command "get-embeddings"    (Options.info Main.parseGetEmbeddings (Options.progDesc "Get embeddings"))
    )

main = do
  let opts = Options.info (Main.cmdParser <**> Options.helper) Options.fullDesc
  cmd <- Options.execParser opts
  case cmd of
    GetEmbeddings -> Main.getEmbeddingsCmd
    OK -> Text.putStrLn "OK"

--------------------------------------------------------------------------------
-- Commands

getEmbeddingsCmd = do
  text <- Text.getContents
  vector <- Main.getEmbeddings text
  ByteString.hPutStr IO.stdout $ Json.encode $ Json.Array vector

--------------------------------------------------------------------------------
-- Utilities

getEmbeddings = \input -> do
  let payload = Json.Object $ Map.fromList [("input", Json.String input)]
  output <- ByteString.readProcessStdout_ $
    Text.setStdin (Text.decodeUtf8 $ Json.encode payload) $
    Process.proc "curl"
        ["-s", "http://localhost:9990/v1/embeddings",
        "-H", "Content-Type: application/json",
        "-X", "POST",
        "--data-binary", "@-"]
  vector <- case Json.decode output of
    Maybe.Just value ->
      case value of
        Json.Object map ->
          case Map.lookup "data" map of
            Maybe.Just embeddings' ->
              case embeddings' of
                Json.Array embeddings -> 
                  case Maybe.listToMaybe $ Vector.toList embeddings of
                    Maybe.Just embedding ->
                      case embedding of
                        Json.Object embed ->
                          case Map.lookup "embedding" embed of
                            Maybe.Just vector' -> case vector' of
                              Json.Array vector -> IO.pure vector
                              _ -> Error.error "Embeddings should be an array."
                            _ -> Error.error "Missing embedding in object."
                        _ -> Error.error "Embedding should be an object."
                    _ -> Error.error "No embeddings!"
                _ -> Error.error "Embeddings should be an array."
            _ -> Error.error "No data field from /v1/embeddings."
        _ -> Error.error "Expected an object from /v1/embeddings."
    Maybe.Nothing -> Error.error "Bad JSON decode from /v1/embeddings."
  IO.pure vector
